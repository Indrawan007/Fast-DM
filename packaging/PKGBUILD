# Maintainer: FastDM Contributors
# PKGBUILD Fast-DM — paket pacman untuk Arch Linux & turunannya
# (Manjaro, EndeavourOS, Garuda, CachyOS, …).
#
# JANGAN jalankan `makepkg` langsung dari folder ini. Berkas ini memakai
# placeholder @VERSION@/@PKGREL@ dan membutuhkan source tarball yang dibuat
# oleh skrip pendampingnya:
#
#   bash packaging/build-arch.sh
#
# Skrip itu menyalin PKGBUILD ke staging dir (build/arch), membuat
# fast-dm-<versi>.tar.gz dari working tree, lalu menjalankan makepkg.
#
# Layout instalasi SENGAJA disamakan dengan paket .deb (/opt/fast-dm +
# symlink /usr/bin/fast-dm + wrapper fast-dm-native) supaya
# `native_host::resolve_native_path()` dan `setup-browser.sh` tidak perlu
# tahu distro apa yang sedang dipakai.
pkgname=fast-dm
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc="High-speed download manager with browser integration (aria2 + yt-dlp)"
arch=('x86_64')
url="https://github.com/Indrawan007/Fast-DM"
license=('MIT')
# Pemetaan dari paket Debian (packaging/control):
#   libgtk-4-1 -> gtk4 · aria2 -> aria2 · yt-dlp -> yt-dlp
#   ffmpeg -> ffmpeg · xdg-utils -> xdg-utils · libnotify-bin -> libnotify
depends=('gtk4' 'aria2' 'yt-dlp' 'ffmpeg' 'xdg-utils')
optdepends=(
  'libnotify: notifikasi desktop saat unduhan selesai/gagal'
  'xclip: monitor clipboard di sesi X11'
  'wl-clipboard: monitor clipboard di sesi Wayland'
  'chrome: browser untuk extension Native Messaging'
)
makedepends=('cargo' 'rust')
# Arch mengaktifkan lto+debug+CFLAGS di /etc/makepkg.conf. cargo build
# --release di job CI yang sama (tanpa flag itu) lolos, lalu makepkg gagal
# di build() dengan exit 4: -flto / RUSTFLAGS debug memecahkan link crate
# campur Rust/C (ring, gtk-sys). Rust LTO tetap jalan lewat Cargo.toml
# [profile.release]; yang dimatikan hanya LTO C/C++ milik makepkg.
options=('!buildflags' '!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz")
# Checksum diisi pembuat tarball lokal; paket ini dibangun dari working tree,
# bukan dari rilis upstream, jadi SKIP (sama pola-nya dengan build lokal lain).
sha256sums=('SKIP')
# Jaring kedua di samping options=(!buildflags !lto !debug): bila makepkg
# atau environment induk tetap mengekspor flag, buang sebelum cargo jalan
# supaya invokasi ini sama dengan `cargo build` yang sudah lolos di CI.
unset_makepkg_rust_flags() {
  unset RUSTFLAGS CARGO_ENCODED_RUSTFLAGS DEBUG_RUSTFLAGS \
    CFLAGS CXXFLAGS LDFLAGS CPPFLAGS
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  unset_makepkg_rust_flags
  # --locked: pakai Cargo.lock apa adanya — sama seperti CI (ci.yml),
  # release.yml, dan packaging/build-deb.sh. LTO / codegen-units / strip /
  # panic=abort sudah diatur Cargo.toml [profile.release].
  cargo build --release --locked --target-dir "$srcdir/target"
}
check() {
  cd "$srcdir/$pkgname-$pkgver"
  unset_makepkg_rust_flags
  # Unit test + integration test Rust. --target-dir sama dengan build()
  # supaya artefak test tidak dikompilasi ulang dari nol.
  cargo test --locked --target-dir "$srcdir/target"
  # Regression test browser extension (Node 22+, tanpa npm install).
  # Opsional: dilewati bila node tidak dipasang di lingkungan build.
  if command -v node >/dev/null 2>&1; then
    node --test tests/extension.test.cjs
  fi
}
package() {
  local src="$srcdir/$pkgname-$pkgver"
  install -Dm755 "$srcdir/target/release/$pkgname" \
    "$pkgdir/opt/$pkgname/$pkgname"
  # Wrapper native messaging host: manifest NMH tidak bisa membawa argumen,
  # jadi Chrome memanggil wrapper ini (identik dengan paket .deb).
  printf '#!/bin/sh\nexec /opt/fast-dm/fast-dm --native\n' >"$srcdir/$pkgname-native"
  install -Dm755 "$srcdir/$pkgname-native" \
    "$pkgdir/opt/$pkgname/$pkgname-native"
  # Symlink agar bisa dipanggil dari terminal.
  install -dm755 "$pkgdir/usr/bin"
  ln -s "/opt/$pkgname/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$src/packaging/fast-dm.desktop" \
    "$pkgdir/usr/share/applications/$pkgname.desktop"
  # Nama icon harus sama dengan field Icon= di .desktop.
  install -Dm644 "$src/extension/icons/icon128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/io.github.fastdm.FastDownloadManager.png"
  # Arch mewajibkan lisensi di /usr/share/licenses/<pkgname>/.
  install -Dm644 "$src/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # Catatan: tidak perlu file .install / gtk-update-icon-cache — Arch punya
  # hook alpm sistem untuk usr/share/icons/hicolor. Manifest Native Messaging
  # juga tidak dibungkus di sini: aplikasi menulisnya sendiri saat start
  # (src/native_host/setup.rs) untuk semua profil browser yang terdeteksi.
}
